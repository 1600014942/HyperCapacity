# API Configuration
# For local development, the Vite proxy will handle requests to /api/*
# and forward them to the backend URL specified below.
# Leave this commented for development to use the Vite proxy.
# Uncomment and set for production builds.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# For production, you would set:
# VITE_API_BASE_URL=https://api.yourdomain.com
